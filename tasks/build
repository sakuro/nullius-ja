#!/usr/bin/env bash
#MISE description="Build MOD archive"
set -euo pipefail

mod_name=$(jq -r .name info.json)
mod_version=$(jq -r .version info.json)
mkdir -p dist
archive="dist/${mod_name}_${mod_version}.zip"

# The archive is built from HEAD, not from the working tree, so freshness must be
# judged against HEAD as well. `git archive` records the commit ID as the zip
# comment; comparing file mtimes misses commits made after the build and deletions.
if [ -f "$archive" ] && [ "$(unzip -z "$archive" 2>/dev/null | tail -n 1)" = "$(git rev-parse HEAD)" ]; then
  exit 0
fi

rm -f "$archive"
git archive --prefix "${mod_name}_${mod_version}/" HEAD -o "$archive"
